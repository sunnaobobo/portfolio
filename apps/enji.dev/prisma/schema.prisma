generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContentMeta {
  id String @id @default(cuid())

  type      ContentType
  title     String
  slug      String     @unique
  views     View[]
  shares    Share[]
  reactions Reaction[]
  createdAt DateTime   @default(now())
}

enum ContentType {
  PAGE
  POST
  PROJECT
}

model View {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  sessionId String

  contentId String
  content   ContentMeta @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([sessionId])
}

model Share {
  id String @id @default(cuid())

  type      ShareType? @default(OTHERS)
  createdAt DateTime   @default(now())
  sessionId String

  contentId String
  content   ContentMeta @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([sessionId])
}

enum ShareType {
  TWITTER
  CLIPBOARD
  OTHERS
}

model Reaction {
  id String @id @default(cuid())

  count     Int?          @default(1)
  section   String?
  type      ReactionType? @default(CLAPPING)
  createdAt DateTime      @default(now())
  sessionId String

  contentId String
  content   ContentMeta @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([sessionId])
}

enum ReactionType {
  CLAPPING
  THINKING
  AMAZED
}
